@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using FastBite.Frontend.ViewModels
@*
   Injetamos o nosso "rádio de comunicação" (HttpClient).
   Na nossa Clean Architecture, o Frontend é um projeto cliente 100% isolado.
   Ele não acede ao DbContext nem à camada Domain do Backend; comunica apenas via HTTP!
*@
@inject HttpClient Http

<PageTitle>FastBite - What are you craving today?</PageTitle>

<div class="container my-4">
    <!-- 1. Cabeçalho / Navbar (Idêntico ao Figma) -->
    <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-3">🍴</span>
            <h3 class="fw-bold m-0" style="color: #ff6b00;">FastBite</h3>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a href="#" class="text-decoration-none text-dark fw-semibold">Menu</a>
            <a href="#" class="text-decoration-none text-dark fw-semibold">Orders</a>
            <a href="#" class="text-decoration-none text-dark fw-semibold">Cart</a>
            <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
                <Authorized>
                    <a href="/logout" data-enhance-nav="false" class="profile-btn btn text-white fw-bold px-4 rounded-pill shadow-sm" style="background-color: #ff6b00;">Logout</a>
                </Authorized>
                <NotAuthorized>
                    @* <a href="/login" class="profile-btn btn text-white fw-bold px-4 rounded-pill shadow-sm" style="background-color: #ff6b00;">Sign in</a> *@
                </NotAuthorized>
            </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
        </div>


    </header>

    <!-- 2. Banner Hero Laranja com Gradiente -->
    <div class="p-5 mb-4 text-white rounded-4 shadow" style="background: linear-gradient(135deg, #ff8c00, #ff5500);">
        <h1 class="display-5 fw-bold mb-2">What are you craving today? 🍽️</h1>
        <p class="fs-5 mb-0 opacity-75">Fresh ingredients · Fast delivery · Happy eating</p>
    </div>

    <!-- 3. Barra de Pesquisa -->
    <div class="mb-4">
        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
            <span class="input-group-text bg-light border-0 ps-4">🔍</span>
            <input type="text" class="form-control bg-light border-0 fs-6 py-3" placeholder="Search burgers, pizza, sushi...">
        </div>
    </div>

    <!-- 4. Filtros de Categoria em Pílula (Pills) -->
    <div class="d-flex gap-2 mb-4 overflow-auto py-1">
        <button class="btn btn-sm px-4 py-2 rounded-pill text-white fw-semibold shadow-sm" style="background-color: #ff6b00;">🍔 All</button>
        <button class="btn btn-sm px-4 py-2 rounded-pill btn-light fw-semibold text-secondary border">🍔 Burgers</button>
        <button class="btn btn-sm px-4 py-2 rounded-pill btn-light fw-semibold text-secondary border">🍕 Pizza</button>
        <button class="btn btn-sm px-4 py-2 rounded-pill btn-light fw-semibold text-secondary border">🍣 Sushi</button>
        <button class="btn btn-sm px-4 py-2 rounded-pill btn-light fw-semibold text-secondary border">🥗 Salads</button>
        <button class="btn btn-sm px-4 py-2 rounded-pill btn-light fw-semibold text-secondary border">🍰 Desserts</button>
        <button class="btn btn-sm px-4 py-2 rounded-pill btn-light fw-semibold text-secondary border">🥤 Drinks</button>
    </div>

    <!-- 5. Contagem de Itens e Indicador de Estado -->
    <div class="d-flex align-items-center gap-2 mb-4">
        <h4 class="fw-bold m-0">All</h4>
        @if (_menuItems != null)
        {
            <span class="badge px-3 py-2 rounded-pill text-dark fw-semibold" style="background-color: #ffe0cc;">@_menuItems.Count items</span>
        }
    </div>

    <!-- 6. Grelha de Produtos (Onde os teus dados da Base de Dados aparecem!) -->
    @if (_menuItems == null)
    {
        <!-- Estado de Carregamento enquanto o Blazor espera pela resposta da API -->
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem;"></div>
            <p class="mt-3 text-muted fw-semibold">A contactar a cozinha para carregar a ementa...</p>
        </div>
    }
    else if (_menuItems.Count == 0)
    {
        <!-- Estado Vazio caso a tabela na base de dados não tenha registos -->
        <div class="alert alert-warning rounded-4 p-4 text-center shadow-sm">
            <h5>🕒 A cozinha está a preparar novos pratos!</h5>
            <p class="mb-0">Não foram encontrados menus disponíveis no sistema de momento.</p>
        </div>
    }
    else
    {
        <!-- Desenhamos 4 cartões por linha em ecrãs grandes, exatamente como no Figma -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5">
            @foreach (var item in _menuItems)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column justify-content-between">

                        <!-- Topo do Cartão: Imagem e Etiqueta de Popular -->
                        <div class="position-relative" style="height: 180px; background-color: #f8f9fa;">
                            @*
                               Como não temos URL de imagem no banco de dados, usamos uma imagem
                               de alta qualidade baseada na categoria para o visual ficar perfeito!
                            *@
                            <img src="@ObterImagemPorCategoria(item.Categoria)"
                                 class="w-100 h-100 object-fit-cover"
                                 alt="@item.Nome" />

                            <!-- Etiqueta laranja "Popular" -->
                            <span class="position-absolute top-0 start-0 m-3 badge text-white px-3 py-2 rounded-pill shadow-sm" style="background-color: #ff6b00;">
                                🔥 Popular
                            </span>
                        </div>

                        <!-- Corpo do Cartão: Informação vinda da tua Base de Dados via DTO -->
                        <div class="card-body p-3 d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="card-title fw-bold m-0 fs-6">@item.Nome</h6>
                                    <!-- Formatamos o Preço Base que vem da tua base de dados com 2 casas decimais -->
                                    <span class="fw-bold fs-6" style="color: #ff6b00;">$@item.PrecoBase.ToString("0.00")</span>
                                </div>
                                <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                                    @item.Descricao
                                </p>
                            </div>

                            <!-- Rodapé do Cartão: Avaliação, Tempo e Botão -->
                            <div>
                                <div class="d-flex gap-3 text-muted small mb-3 fw-semibold">
                                    <span>⭐ 4.8</span>
                                    <span>🕒 15 min</span>
                                </div>
                                <button class="btn w-100 text-white fw-bold rounded-3 py-2 shadow-sm" style="background-color: #ff6b00; transition: 0.2s;">
                                    + Add to cart
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    // A nossa lista privada que vai segurar os dados dos tabuleiros (ViewModels) na memória do ecrã
    private List<MenuItemViewModel>? _menuItems;

    // Método de ciclo de vida do Blazor: corre automaticamente mal a página é aberta no navegador
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // O Fluxo da Informação:
            // 1. O Blazor envia um pedido HTTP GET ao endpoint da nossa camada API.
            // 2. A API delega para a Application (Service) -> que consulta a Infrastructure (Repository) -> Base de Dados.
            // 3. O GetFromJsonAsync pega no JSON que voltou e converte-o magicamente para a nossa lista C#!
            _menuItems = await Http.GetFromJsonAsync<List<MenuItemViewModel>>("api/menus/ObterTodos");
        }
        catch (Exception ex)
        {
            // Se houver falha de rede, CORS, ou se a API estiver desligada, capturamos o erro em segurança
            Console.WriteLine($"Erro ao contactar a API do MenuCatalog: {ex.Message}");
            _menuItems = new List<MenuItemViewModel>(); // Evita que o ecrã fique em loading infinito
        }
    }

    // Método auxiliar exclusivo de apresentação (Frontend) para atribuir fotos bonitas
    // aos teus pratos enquanto não adicionamos uma coluna de Imagem na base de dados!
    private string ObterImagemPorCategoria(string categoria)
    {
        var cat = categoria.ToLower();
        if (cat.Contains("burger") || cat.Contains("hamburguer"))
            return "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=500";
        if (cat.Contains("pizza"))
            return "https://images.unsplash.com/photo-1604382355076-af4b0eb60143?w=500";
        if (cat.Contains("sushi"))
            return "https://images.unsplash.com/photo-1579871494447-9811cf80d66c?w=500";
        if (cat.Contains("salada") || cat.Contains("salad"))
            return "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=500";

        // Imagem padrão apetitosa caso a categoria seja diferente
        return "https://images.unsplash.com/photo-1550547660-d9450f859349?w=500";
    }
}