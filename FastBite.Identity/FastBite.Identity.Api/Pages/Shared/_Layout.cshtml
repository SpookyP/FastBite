<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />

    <title>FastBite - Autenticação</title>

    <!-- Podes depois colocar aqui o logo do FastBite -->
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            /* Garante que TODAS as páginas do IdentityServer têm o fundo bege da tua marca */
            body {
                background-color: #FAF8F5;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            }
    </style>
</head>
<body>
    <!-- A barra de navegação do topo (Menu, Saco, Sign in) -->
    <partial name="_Nav" />

    <!-- Conteúdo das páginas (Login, Registo, Logout) -->
    <div class="container body-container">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.slim.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>