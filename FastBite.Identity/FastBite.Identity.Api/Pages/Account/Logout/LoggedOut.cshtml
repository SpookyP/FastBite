@page
@model FastBite.Pages.Logout.LoggedOut

<div class="logged-out-page">
    <h2>
       
        <small>Sessão terminada com sucesso.</small>
    </h2>

    @if (Model.View.PostLogoutRedirectUri != null)
    {
        <div>
            Clique <a class="PostLogoutRedirectUri" href="@Model.View.PostLogoutRedirectUri">aqui</a> para voltar a 
            <span>@Model.View.ClientName</span>.
        </div>
    }
</div>

@section scripts
{
    @if (Model.View.AutomaticRedirectAfterSignOut)
    {
        <script src="~/js/signout-redirect.js"></script>
    }
}