@page
@model FastBite.Pages.Logout.Index

<div class="login-page">
    <div class="login-card" style="text-align: center; margin-top: 200px;">

        <!-- Ícone de Saída -->
        <div style="background-color: #FFF0ED; color: #FF3B30; width: 64px; height: 64px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        </div>

        <h2>Sign out</h2>
        <p class="login-subtitle">Are you sure you want to log out of your FastBite account?</p>

        <form asp-page="/Account/Logout/Index">
            <input type="hidden" name="logoutId" value="@Model.LogoutId" />

            <button class="btn-fastbite" style="background-color: #1A1A1A; margin-bottom: 12px;">Yes, sign me out</button>
            <a href="@Model.CancelUrl" class="register-link" style="color: #7A7571; font-weight: 500;">Cancel and return</a>
        </form>
    </div>
</div>