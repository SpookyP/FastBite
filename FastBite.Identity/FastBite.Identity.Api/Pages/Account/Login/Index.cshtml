@page
@model FastBite.Pages.Login.Index

<style>
    /* 1. Fundo da página e resets */
    body {
        background-color: #FAF8F5; /* Cor bege clarinha do fundo */
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* 2. Área do Logotipo (Acima do Card) */
    .brand-header {
        text-align: center;
        margin-top: 50px;
        margin-bottom: 30px;
    }

    .brand-logo-icon {
        background-color: #F25F1D; /* Laranja FastBite */
        color: white;
        width: 60px;
        height: 60px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .brand-title {
        color: #F25F1D;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .brand-subtitle {
        color: #7A7571;
        font-size: 15px;
        margin-top: 4px;
    }

    /* 3. O Cartão de Login Branco */
    .login-card {
        background-color: #FFFFFF;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
        padding: 40px;
        max-width: 440px;
        margin: 0 auto;
        border: none;
    }

    .login-card h2 {
        font-size: 24px;
        font-weight: 600;
        color: #1A1A1A;
        margin-bottom: 8px;
    }

    .login-subtitle {
        color: #7A7571;
        font-size: 14px;
        margin-bottom: 28px;
        line-height: 1.5;
    }

    /* 4. Inputs customizados (Fundo bege, sem borda) */
    .form-group label {
        font-size: 13px;
        font-weight: 600;
        color: #1A1A1A;
        margin-bottom: 6px;
        display: block;
    }

    .custom-input-group {
        display: flex;
        align-items: center;
        background-color: #F6F3EB;
        border-radius: 8px;
        padding: 0 14px;
        margin-bottom: 20px;
        transition: all 0.2s;
    }

    .custom-input-group:focus-within {
        box-shadow: 0 0 0 2px #F25F1D33;
    }

    .custom-input-icon {
        color: #A39E99;
        display: flex;
        align-items: center;
    }

    .custom-input {
        background: transparent;
        border: none;
        padding: 12px 10px;
        width: 100%;
        color: #1A1A1A;
        font-size: 14px;
        outline: none;
    }

    .custom-input::placeholder {
        color: #A39E99;
    }

    /* 5. Botão Laranja e Links */
    .btn-fastbite {
        background-color: #F25F1D;
        color: #FFFFFF;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-weight: 600;
        font-size: 15px;
        width: 100%;
        transition: background-color 0.2s;
        margin-top: 10px;
    }

    .btn-fastbite:hover {
        background-color: #D95317;
        color: #FFFFFF;
    }

    .register-link-container {
        text-align: center;
        margin-top: 24px;
        font-size: 13px;
        color: #7A7571;
    }

    .register-link {
        color: #F25F1D;
        font-weight: 600;
        text-decoration: none;
    }

    .register-link:hover {
        text-decoration: underline;
    }
</style>

<div class="login-page">
    <partial name="_ValidationSummary" />

    @if (Model.View.EnableLocalLogin)
    {
        <!-- Área do Logo Superior -->
        <div class="brand-header">
            <div class="brand-logo-icon">
                <!-- Ícone SVG de Talheres (semelhante ao da imagem) -->
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
                    <path d="M7 2v20" />
                    <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
                </svg>
            </div>
            <h1 class="brand-title">FastBite</h1>
            <p class="brand-subtitle">Good food, fast delivery.</p>
        </div>

        <!-- Cartão Branco de Login -->
        <div class="login-card">
            <h2>Sign in</h2>
            <p class="login-subtitle">
                Enter your credentials to continue. Try <br />
                <strong style="color: #1A1A1A;">demo@fastbite.com / password</strong>.
            </p>

            <form asp-page="/Account/Login/Index">
                <input type="hidden" asp-for="Input.ReturnUrl" />

                <!-- Input de Email -->
                <div class="form-group">
                    <label asp-for="Input.Username">Email</label>
                    <div class="custom-input-group">
                        <div class="custom-input-icon">
                            <!-- Ícone Envelope SVG -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                        </div>
                        <input class="custom-input" placeholder="demo@fastbite.com" asp-for="Input.Username" autofocus>
                    </div>
                </div>

                <!-- Input de Password -->
                <div class="form-group">
                    <label asp-for="Input.Password">Password</label>
                    <div class="custom-input-group">
                        <div class="custom-input-icon">
                            <!-- Ícone Cadeado SVG -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </div>
                        <input type="password" class="custom-input" placeholder="••••••••" asp-for="Input.Password" autocomplete="off">
                    </div>
                </div>

                <!-- O IdentityServer precisa do Input.Button = "login" para processar o formulário -->
                <button class="btn-fastbite" name="Input.Button" value="login">Sign in</button>

                <!-- Link para Criar Conta (Podes apontar isto para a tua página de registo futura) -->
                <div class="register-link-container">
                    Don't have an account? <a href="#" class="register-link">Create one</a>
                </div>
            </form>
        </div>
    }

    <!-- Fallback de Segurança caso existam Logins Externos (Google, etc.) no futuro -->
    @if (Model.View.VisibleExternalProviders.Any())
    {
        <div class="login-card" style="margin-top: 20px; text-align: center;">
            <p style="font-size: 13px; color: #7A7571; margin-bottom: 10px;">Or continue with</p>
            @foreach (var provider in Model.View.VisibleExternalProviders)
            {
                <a class="btn-fastbite" style="background-color: #1A1A1A; display: inline-block; width: 100%; text-decoration: none; margin-bottom: 10px;"
                   asp-page="/ExternalLogin/Challenge"
                   asp-route-scheme="@provider.AuthenticationScheme"
                   asp-route-returnUrl="@Model.Input.ReturnUrl">
                    @provider.DisplayName
                </a>
            }
        </div>
    }
</div>